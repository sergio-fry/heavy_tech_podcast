<% content_for :title, "Posts" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center flex-wrap gap-2">
    <h1 class="font-bold text-4xl">Posts</h1>
    <div class="flex gap-2">
      <%= link_to "Корзина", trash_posts_path, class: "rounded-md px-3.5 py-2.5 bg-gray-200 hover:bg-gray-300 font-medium" %>
      <%= link_to "New post", new_post_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>

  <div id="posts" class="min-w-full space-y-6">
    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <div class="border border-gray-200 rounded-lg p-5 bg-white shadow-sm">
          <div class="flex flex-col sm:flex-row justify-between items-start gap-4 sm:gap-4">
            <div class="flex-1 min-w-0">
              <%= render post %>
            </div>
            <div class="w-full sm:w-auto flex flex-col sm:flex-row gap-2 shrink-0">
              <%= link_to "Show", post, class: "text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
              <%= link_to "Edit", edit_post_path(post), class: "text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
              <%= button_to "Destroy", post, method: :delete, class: "rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No posts found.</p>
    <% end %>
  </div>
</div>
