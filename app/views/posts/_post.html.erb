<div id="<%= dom_id post %>" class="w-full sm:w-auto my-5 space-y-3">
  <div class="flex items-center gap-2 flex-wrap">
    <span class="inline-block px-2 py-0.5 text-xs font-medium rounded <%= post.is_a?(Episode) ? 'bg-indigo-100 text-indigo-800' : 'bg-gray-100 text-gray-800' %>">
      <%= post.is_a?(Episode) ? 'Эпизод' : 'Статья' %>
    </span>
  </div>
  <h2 class="text-2xl font-semibold">
    <%= link_to post.title, post_path(post), class: "text-gray-900 hover:text-blue-600" %>
  </h2>
  <% unless local_assigns[:show_body] %>
    <% if post.excerpt.present? %>
      <p class="text-gray-600"><%= post.excerpt %></p>
    <% end %>
    <p class="text-sm text-gray-500"><%= l(post.created_at, format: :long) %></p>
    <% if post.is_a?(Episode) %>
      <%= render "episodes/episode_metadata", episode: post %>
      <%= render "episodes/audio_player", episode: post %>
    <% end %>
  <% end %>
  <% if local_assigns[:show_body] %>
    <div class="prose">
      <%= post.body %>
    </div>
    <% if post.is_a?(Episode) %>
      <%= render "episodes/episode_metadata", episode: post %>
      <%= render "episodes/audio_player", episode: post %>
    <% end %>
  <% end %>
</div>
