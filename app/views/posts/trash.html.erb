<% content_for :title, "Корзина" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center flex-wrap gap-2 mb-5">
    <h1 class="font-bold text-4xl">Корзина</h1>
    <%= link_to "Back to posts", posts_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium" %>
  </div>

  <div id="trash_posts" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @posts.any? %>
      <% @posts.each do |post| %>
        <div id="<%= dom_id post %>" class="flex flex-col sm:flex-row justify-between items-start sm:items-center py-5 gap-2">
          <div class="flex-1">
            <strong class="block font-medium mb-1"><%= post.title %></strong>
            <span class="text-sm text-gray-500">Удалён <%= l(post.deleted_at, format: :short) %></span>
          </div>
          <%= button_to "Восстановить", restore_post_path(post), method: :post, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer", data: { turbo_confirm: "Восстановить пост?" } %>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">Корзина пуста.</p>
    <% end %>
  </div>
</div>
