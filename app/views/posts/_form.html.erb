<%= form_with(model: post, url: post.persisted? ? post_path(post) : posts_path, scope: :post, class: "contents") do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul class="list-disc ml-6">
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :type, value: post.type %>

  <div class="my-5">
    <%= form.label :title %>
    <%= form.text_field :title, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": post.errors[:title].none?, "border-red-400 focus:outline-red-600": post.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :body %>
    <%= form.rich_text_area :body, class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full min-h-[200px]" %>
  </div>

  <% if post.is_a?(Episode) %>
    <div class="my-5">
      <%= form.label :audio_file, "MP3 file" %>
      <%= form.file_field :audio_file, accept: "audio/mpeg,audio/mp3", class: "block shadow-sm rounded-md border border-gray-400 px-3 py-2 mt-2 w-full" %>
      <% if post.audio_file.attached? %>
        <p class="text-sm text-gray-500 mt-1">Current file: <%= post.audio_file.filename %> (<%= post.duration_seconds ? "#{post.duration_seconds / 60} min" : 'processing…' %>)</p>
      <% end %>
    </div>
  <% end %>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
