<% if episode.audio_file.attached? %>
  <div class="mt-3">
    <audio controls class="w-full max-w-md" preload="metadata">
      <source src="<%= url_for(episode.audio_file) %>" type="<%= episode.audio_file.content_type %>">
      Your browser does not support the audio element.
    </audio>
  </div>
<% end %>
